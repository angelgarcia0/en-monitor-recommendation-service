<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Outbox of the recommendation service.

        Every recommendation.created the notification service must receive is written here right
        after the recommendation it announces, and a relay publishes it to the message broker
        afterwards, in order and at least once. A broker or a notification service that is down
        delays a message but does not lose it.

        Its own table rather than backend_outbox: that one belongs to energy-monitor-backend, which
        relays its own recommendations through it until the cutover.
    -->
    <changeSet id="recommendation-002-create-recommendation-outbox" author="angelgarcia0">
        <comment>Creates the recommendation_outbox table of the transactional outbox.</comment>

        <createTable tableName="recommendation_outbox">
            <!-- Also the message id on the broker: consumers use it to drop duplicates. -->
            <column name="id_message" type="VARCHAR(10)">
                <constraints primaryKey="true" primaryKeyName="pk_recommendation_outbox" nullable="false"/>
            </column>
            <!-- Routing key on the broker, for example recommendation.created. -->
            <column name="message_type" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="DATETIME(6)"/>
            <column name="discarded_at" type="DATETIME(6)"/>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_error" type="VARCHAR(255)"/>
        </createTable>

        <!-- The relay reads the pending messages in order. -->
        <createIndex tableName="recommendation_outbox" indexName="idx_recommendation_outbox_pending">
            <column name="published_at"/>
            <column name="discarded_at"/>
            <column name="occurred_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="recommendation_outbox"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
